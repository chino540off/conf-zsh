#compdef samnefni

autoload -U is-at-least

_samnefni() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--config=[configuration path]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_samnefni_commands" \
"*::: :->samnefni" \
&& ret=0
    case $state in
    (samnefni)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:samnefni-command-$line[1]:"
        case $line[1] in
            (execute)
_arguments "${_arguments_options[@]}" : \
'--dry-run[configuration path]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'*::command:' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'--shell=[target shell]:SHELL:(bash elvish fish powershell zsh)' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'::command -- Alias command:' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_samnefni__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:samnefni-help-command-$line[1]:"
        case $line[1] in
            (execute)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_samnefni_commands] )) ||
_samnefni_commands() {
    local commands; commands=(
'execute:Execute a command and tries to bind aliases' \
'completion:Generate completion for a resquested shell' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'samnefni commands' commands "$@"
}
(( $+functions[_samnefni__completion_commands] )) ||
_samnefni__completion_commands() {
    local commands; commands=()
    _describe -t commands 'samnefni completion commands' commands "$@"
}
(( $+functions[_samnefni__execute_commands] )) ||
_samnefni__execute_commands() {
    local commands; commands=()
    _describe -t commands 'samnefni execute commands' commands "$@"
}
(( $+functions[_samnefni__help_commands] )) ||
_samnefni__help_commands() {
    local commands; commands=(
'execute:Execute a command and tries to bind aliases' \
'completion:Generate completion for a resquested shell' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'samnefni help commands' commands "$@"
}
(( $+functions[_samnefni__help__completion_commands] )) ||
_samnefni__help__completion_commands() {
    local commands; commands=()
    _describe -t commands 'samnefni help completion commands' commands "$@"
}
(( $+functions[_samnefni__help__execute_commands] )) ||
_samnefni__help__execute_commands() {
    local commands; commands=()
    _describe -t commands 'samnefni help execute commands' commands "$@"
}
(( $+functions[_samnefni__help__help_commands] )) ||
_samnefni__help__help_commands() {
    local commands; commands=()
    _describe -t commands 'samnefni help help commands' commands "$@"
}

if [ "$funcstack[1]" = "_samnefni" ]; then
    _samnefni "$@"
else
    compdef _samnefni samnefni
fi
